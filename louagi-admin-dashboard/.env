# ========================================
# 🎨 LOUAGI ADMIN DASHBOARD CONFIGURATION
# ========================================

# ========================================
# 🌐 API CONNECTION
# ========================================
REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_BACKEND_URL=http://localhost:5000

# ========================================
# 🏢 APPLICATION INFO
# ========================================
REACT_APP_APP_NAME=Louagi Admin Dashboard
REACT_APP_APP_VERSION=1.0.0
REACT_APP_COMPANY_NAME=Louagi Transportation

# ========================================
# 🔧 ENVIRONMENT SETTINGS
# ========================================
REACT_APP_ENV=development
REACT_APP_DEBUG=true

# ========================================
# 💳 STRIPE CONFIGURATION (Frontend)
# ========================================
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_51RVuo6ALVnc4tntayhIZmjEVw4bxb3xhp2ZlJLIzhy5bUP7FU1UWa1cIXOOhUyBq1dGq1SwCyzh6Uw13FSkY0q4200n6PzGxgt

# ========================================
# 🎛️ UI CONFIGURATION
# ========================================
# Pagination
REACT_APP_ITEMS_PER_PAGE=10
REACT_APP_MAX_ITEMS_PER_PAGE=100

# API Settings
REACT_APP_API_TIMEOUT=10000
REACT_APP_RETRY_ATTEMPTS=3

# ========================================
# 🎨 THEME CONFIGURATION
# ========================================
REACT_APP_PRIMARY_COLOR=#3B82F6
REACT_APP_SECONDARY_COLOR=#6B7280
REACT_APP_SUCCESS_COLOR=#10B981
REACT_APP_ERROR_COLOR=#EF4444
REACT_APP_WARNING_COLOR=#F59E0B

# ========================================
# 📊 DASHBOARD SETTINGS
# ========================================
REACT_APP_REFRESH_INTERVAL=30000
REACT_APP_AUTO_REFRESH=true
REACT_APP_SHOW_DEBUG_INFO=true

# ========================================
# 🔐 AUTHENTICATION SETTINGS
# ========================================
REACT_APP_SESSION_TIMEOUT=1440
REACT_APP_REMEMBER_ME_DAYS=7
REACT_APP_AUTO_LOGOUT_WARNING=300

# ========================================
# 📱 RESPONSIVE SETTINGS
# ========================================
REACT_APP_MOBILE_BREAKPOINT=768
REACT_APP_TABLET_BREAKPOINT=1024
REACT_APP_DESKTOP_BREAKPOINT=1280

# ========================================
# 🌍 LOCALIZATION
# ========================================
REACT_APP_DEFAULT_LANGUAGE=en
REACT_APP_TIMEZONE=Africa/Tunis
REACT_APP_CURRENCY=USD
REACT_APP_DATE_FORMAT=MM/dd/yyyy
REACT_APP_TIME_FORMAT=HH:mm

# ========================================
# 🔍 DEVELOPMENT TOOLS
# ========================================
# React DevTools
REACT_APP_ENABLE_DEVTOOLS=true

# Performance monitoring
REACT_APP_ENABLE_ANALYTICS=false
REACT_APP_ANALYTICS_ID=

# Error tracking
REACT_APP_ENABLE_ERROR_TRACKING=true
REACT_APP_SENTRY_DSN=

# ========================================
# 🚀 BUILD CONFIGURATION
# ========================================
# Disable source maps in production for security
GENERATE_SOURCEMAP=true

# Bundle analyzer
REACT_APP_BUNDLE_ANALYZER=false

# PWA Settings
REACT_APP_ENABLE_PWA=false